# Copy this file to .env and fill in your real values.
# Never commit your .env file.

APP_NAME=GPO RAG Chatbot

# Gemini API key. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Supabase: click "Connect" at the top of your project > "Session pooler",
# copy the URI, and replace [YOUR-PASSWORD] with your database password.
# While this still contains "YOUR_", the app will not try to connect.
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Embeddings. EMBEDDING_DIMENSION must match vector(...) in
# sql/001_create_document_chunks.sql. Google recommends 768, 1536 or 3072.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
# Chunks sent per API request (max 100). Lower it if you hit rate limits.
EMBEDDING_BATCH_SIZE=50
# How many times to retry a batch after a rate-limit or server error
EMBEDDING_MAX_RETRIES=4
# Seconds to wait for one embedding request
EMBEDDING_TIMEOUT_SECONDS=30
# After a rate-limit error, wait as long as Gemini asks, up to this many seconds.
# The free tier allows about 100 embeddings per minute (each chunk counts as one).
EMBEDDING_MAX_RETRY_WAIT_SECONDS=90

# Chat model used by POST /chat. Google retires models regularly; check
# https://ai.google.dev/gemini-api/docs/deprecations before choosing one.
CHAT_MODEL=gemini-3.5-flash
# Optional: a second model that answers when CHAT_MODEL is overloaded (503
# "high demand"). Leave empty to turn this off. Example: gemini-3.1-flash-lite
CHAT_FALLBACK_MODEL=
# Leave empty to use the model's default (Google advises this for Gemini 3+)
CHAT_TEMPERATURE=
# Includes the model's "thinking" tokens on Gemini 2.5+, so keep it generous
CHAT_MAX_OUTPUT_TOKENS=4096
# Seconds to wait for one Gemini request, and how many times to retry it
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_RETRIES=2
# Longest question accepted, in characters
CHAT_MAX_QUESTION_CHARS=2000

# Retrieval: how many chunks a search returns by default, and the most a
# caller may ask for. Optional RETRIEVAL_MIN_SIMILARITY (cosine, -1 to 1)
# hides weak matches; leave it empty to always return the top results.
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_MIN_SIMILARITY=
# Hybrid search: candidates taken from vector search and from keyword search
# before merging and reranking, and the most text given to the chat model.
RETRIEVAL_CANDIDATES=30
RETRIEVAL_CONTEXT_MAX_CHARS=12000
# Local reranker. Downloaded once (~1.1 GB); about 2 s per question on a laptop CPU.
# Set RERANK_ENABLED=false to skip it (faster, slightly less accurate).
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=20

# Enrichment of structured and visual documents while they are processed:
# Gemini describes charts, summarizes tables and (structured) chapters.
# ENRICHMENT_MODEL defaults to CHAT_MODEL. The MAX_ settings cap the requests
# one document may use; MIN_INTERVAL spaces requests out for free-tier limits.
ENRICHMENT_ENABLED=true
ENRICHMENT_MODEL=
ENRICHMENT_MAX_FIGURES=40
ENRICHMENT_MAX_TABLES=80
ENRICHMENT_MAX_SECTIONS=30
ENRICHMENT_MIN_INTERVAL_SECONDS=4
ENRICHMENT_TIMEOUT_SECONDS=120

# PDF uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# Chunking (in characters). Overlap must be smaller than chunk size.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
